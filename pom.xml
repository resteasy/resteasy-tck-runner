    <scm>
        <connection>scm:git:git@github.com:resteasy/resteasy-tck-runner.git</connection>
        <developerConnection>scm:git:git@github.com:resteasy/resteasy-tck-runner.git</developerConnection>
        <url>https://github.com/resteasy/resteasy-tck-runner</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>jamezp</id>
            <name>James Perkins</name>
            <email>jperkins@ibm.com</email>
            <url>https://resteasy.dev</url>
            <organization>IBM</organization>
            <roles>
                <role>project-lead</role>
            </roles>
            <timezone>-8</timezone>
        </developer>
    </developers>

    <modules>
        <module>resteasy-tck-setup</module>
