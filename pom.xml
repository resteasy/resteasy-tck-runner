    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.resteasy.tck</groupId>
    <artifactId>resteasy-tck-runner-parent</artifactId>
    <version>3.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
